{
  "name": "blog",
  "private": true,
  "type": "module",
  "scripts": {},
  "sideEffects": false,
  "nx": {
    "name": "blog",
    "tags": [
      "scope:blog",
      "type:app"
    ],
    "targets": {
      "preview": {
        "command": "vite preview --port 4300",
        "dependsOn": [
          "build"
        ],
        "options": {
          "cwd": "{projectRoot}"
        }
      },
      "deploy": {
        "command": "wrangler deploy",
        "dependsOn": [
          "build"
        ],
        "options": {
          "cwd": "{projectRoot}"
        }
      },
      "maintenance": {
        "command": "wrangler kv key put maintenance off --binding MAINTENANCE_KV --remote",
        "defaultConfiguration": "off",
        "cache": false,
        "options": {
          "cwd": "{projectRoot}"
        },
        "configurations": {
          "on": {
            "command": "wrangler kv key put maintenance on --binding MAINTENANCE_KV --remote"
          },
          "off": {}
        }
      },
      "assess": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          "build"
        ],
        "options": {
          "cwd": "{workspaceRoot}",
          "command": "node tools/assess.mjs"
        }
      },
      "check-og": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/content/posts/**/*.mdx",
          "{projectRoot}/public/og/**/*.png",
          "{projectRoot}/public/og.png",
          "{workspaceRoot}/tools/check-og.mjs"
        ],
        "options": {
          "cwd": "{workspaceRoot}",
          "command": "node tools/check-og.mjs"
        }
      },
      "diagrams": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/content/**/*.mdx",
          "{projectRoot}/tools/mermaid-generate.mjs",
          "{projectRoot}/tools/mermaid-theme.mjs"
        ],
        "outputs": [
          "{projectRoot}/app/diagrams",
          "{projectRoot}/app/diagrams-draft"
        ],
        "options": {
          "cwd": "{workspaceRoot}",
          "command": "node apps/blog/tools/mermaid-generate.mjs"
        }
      },
      "check-diagrams": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/content/posts/**/*.mdx",
          "{projectRoot}/app/diagrams/**/*.svg",
          "{workspaceRoot}/tools/check-diagrams.mjs"
        ],
        "options": {
          "cwd": "{workspaceRoot}",
          "command": "node tools/check-diagrams.mjs"
        }
      },
      "lint": {
        "dependsOn": [
          "check-og",
          "check-diagrams"
        ]
      },
      "sbom": {
        "executor": "@fmmenchi/nx-trivy:sbom",
        "cache": false,
        "configurations": {
          "docker": {
            "runner": "docker"
          }
        }
      }
    }
  },
  "dependencies": {
    "@dev-blog/icons": "workspace:*",
    "@dev-blog/theme": "workspace:*",
    "@dev-blog/ui": "workspace:*",
    "isbot": "^4.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.43.0",
    "@react-router/dev": "^8.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "mermaid": "^11.16.0",
    "shiki": "^4.3.1",
    "unified": "^11.0.5",
    "wrangler": "^4.107.0"
  },
  "version": "0.8.0"
}
